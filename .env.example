# Copy to .env and fill in. .env is gitignored; .env.example is not.
#
# Real environment variables always win over anything in .env, so a value
# injected by your orchestrator or CI cannot be shadowed by a stale file here.

# ---- provider -----------------------------------------------------------
GUARDRAILS_PROVIDER=openai
OPENAI_API_KEY=sk-proj-replace-me

# Groq (OpenAI-compatible). Required for the Groq routes in config/models.yaml
# and for the Prompt Guard / gpt-oss-safeguard classifiers. The gateway refuses
# to fall back to the OpenAI key for Groq.
GROQ_API_KEY=gsk_replace-me

# Model catalog: aliases, fallbacks, per-route max_tokens. With it, every
# provider that has a key is routable; GUARDRAILS_PROVIDER is the default for
# names the catalog does not list.
GUARDRAILS_MODELS=config/models.yaml

# Optional. Set these to scope billing and rate limits to one org/project.
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

# Optional. Point at any OpenAI-compatible endpoint: Azure OpenAI, vLLM,
# Ollama, Groq, OpenRouter, or a local gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Defaults to gpt-5 when the provider is openai. Any model in the pricing
# table works; unpriced models are served but reported at $0 and listed by
# grctl as unknown.
# GUARDRAILS_DEFAULT_MODEL=gpt-5

# Reasoning depth for the o-series and GPT-5 models: minimal|low|medium|high.
# GUARDRAILS_EFFORT=medium

# ---- engine -------------------------------------------------------------
# REQUIRED in any multi-replica deployment: this keys the redaction vault, so
# every replica must share the same value or a prompt masked on one instance
# cannot be unmasked on another. At least 16 characters.
GUARDRAILS_SECRET=change-me-to-a-long-random-string

# Comma-separated. Leave unset to disable authentication (localhost only).
# GUARDRAILS_API_KEYS=key-one,key-two

# GUARDRAILS_POLICY=config/policies/balanced.yaml
# GUARDRAILS_STRICT=false
# GUARDRAILS_ADDR=:8080
# GUARDRAILS_LOG_LEVEL=info
# GUARDRAILS_TENANT_METRICS=false

# Override the built-in price table when you buy through a reseller or
# marketplace, or when prices change.
# GUARDRAILS_PRICING=config/pricing.yaml

# ---- semantic tier (model classifiers behind the deterministic guards) ----
# off | shadow | cascade | always   (see docs/adr/0007-semantic-tier.md)
# GUARDRAILS_JUDGE_MODE=off
# GUARDRAILS_JUDGE_CLASSIFIERS=prompt-guard-86m        # also: safeguard-20b, moderation, any chat alias
# GUARDRAILS_JUDGE_STAGES=inbound                      # inbound,outbound
# GUARDRAILS_JUDGE_PARALLEL=false                      # overlap classifier with the upstream call
# GUARDRAILS_JUDGE_TIMEOUT=3s
# GUARDRAILS_JUDGE_FAIL_CLOSED=false
# GUARDRAILS_JUDGE_ESCALATE_ABOVE=0.25                 # cascade band floor
# GUARDRAILS_JUDGE_COMBINE=any                         # any | all

# ---- efficiency ------------------------------------------------------------
# GUARDRAILS_CACHE_SIZE=1000                # 0 disables the exact cache
# GUARDRAILS_CACHE_TTL=1h
# GUARDRAILS_SEMANTIC_CACHE=false           # measure first: grctl experiment efficiency
# GUARDRAILS_SEMANTIC_CACHE_THRESHOLD=0.95

# ---- observability -----------------------------------------------------------
# GUARDRAILS_OTLP_ENDPOINT=localhost:4318   # OTLP/HTTP (Jaeger, Tempo, collector)
# GUARDRAILS_LOG_FILE=                      # JSON copy of stdout for a log shipper

# ---- MCP gateway and agent runtime ------------------------------------------
# GUARDRAILS_MCP=config/mcp.yaml                       # enables POST /mcp and /v1/agent/run
# GUARDRAILS_MCP_DEMO_URL=http://localhost:8090/mcp    # where `grctl mcp-demo` listens
# GUARDRAILS_EXPERIMENTS_DIR=experiments               # results shown on /showcase
